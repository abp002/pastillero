<?xml version="1.0" encoding="utf-8"?>
<!-- Nada sale del móvil: ni copia en la nube ni al pasar a otro móvil. Son datos de salud. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
